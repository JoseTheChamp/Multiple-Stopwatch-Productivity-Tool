<?xml version="1.0" encoding="utf-8"?>
<!-- This project has no private dependencies; use only nuget.org so restores don't depend on other feeds. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
