<Window x:Class="MultiStopwatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MultiStopwatch"
        Title="{Binding WindowTitle}"
        Topmost="{Binding AlwaysOnTop}"
        Icon="Assets/Stopwatch.ico"
        Width="600" Height="720" MinWidth="470" MinHeight="460"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:VisibilityConverter x:Key="VisibleWhen" />

        <Style x:Key="TimerCard" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TimerPlayButton" TargetType="Button" BasedOn="{StaticResource PlayButton}">
            <Setter Property="Content" Value="&#xE768;" />
            <Setter Property="ToolTip" Value="Start this timer (stops whichever one is running)" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Content" Value="&#xE769;" />
                    <Setter Property="ToolTip" Value="Pause" />
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TimerTimeBox" TargetType="TextBox" BasedOn="{StaticResource TimeBox}">
            <Setter Property="ToolTip">
                <Setter.Value>
                    <TextBlock>
                        Click and type a new time: 1:30:00, 1:30, 45m, 1,5h or 90 (minutes).<LineBreak />
                        Type +15m or -10m to add / subtract.<LineBreak />
                        ↑/↓ ±1 minute, Shift+↑/↓ ±1 hour. Enter to set, Esc to cancel.
                    </TextBlock>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="ToolTip" Value="Pause the timer to edit its time" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Cells of the saved table; the per-save "Total" rows are bold. -->
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTotal}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellTextRight" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <DataTemplate x:Key="TimerTemplate">
            <Border Style="{StaticResource TimerCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button Grid.RowSpan="2" VerticalAlignment="Center" Style="{StaticResource TimerPlayButton}"
                            Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />

                    <TextBox x:Name="NameBox" Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="80" FontSize="15"
                             ToolTip="Timer name — click to rename"
                             KeyDown="NameBox_KeyDown" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="14,5,6,0" VerticalAlignment="Center"
                               Style="{StaticResource Caption}" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />

                    <TextBox x:Name="TimeBox" Grid.Column="2" Style="{StaticResource TimerTimeBox}"
                             Text="{Binding ElapsedText, Mode=OneWay}"
                             IsReadOnly="{Binding IsRunning}"
                             PreviewMouseLeftButtonDown="TimeBox_PreviewMouseLeftButtonDown"
                             GotKeyboardFocus="TimeBox_GotKeyboardFocus"
                             PreviewKeyDown="TimeBox_PreviewKeyDown"
                             LostKeyboardFocus="TimeBox_LostKeyboardFocus" />
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,6,0">
                        <Button Style="{StaticResource ChipButton}" Content="−5" Tag="-5" ToolTip="Remove 5 minutes" Click="AdjustButton_Click" />
                        <Button Style="{StaticResource ChipButton}" Content="−1" Tag="-1" ToolTip="Remove 1 minute" Click="AdjustButton_Click" />
                        <Button Style="{StaticResource ChipButton}" Content="+1" Tag="1" ToolTip="Add 1 minute" Click="AdjustButton_Click" />
                        <Button Style="{StaticResource ChipButton}" Content="+5" Tag="5" ToolTip="Add 5 minutes" Click="AdjustButton_Click" />
                    </StackPanel>

                    <Button Grid.Column="3" Grid.RowSpan="2" VerticalAlignment="Center" Style="{StaticResource IconButton}" Margin="4,0,0,0"
                            Content="&#xE72C;" ToolTip="Clear — stop and reset to 00:00:00"
                            Command="{Binding DataContext.ResetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                    <Button Grid.Column="4" Grid.RowSpan="2" VerticalAlignment="Center" Style="{StaticResource DangerIconButton}"
                            Content="&#xE74D;" ToolTip="Remove this timer"
                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter TargetName="TimeBox" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Margin="12,8,12,0">
            <!-- ============================== Timers ============================== -->
            <TabItem Header="Timers">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ItemsControl x:Name="TimerList" ItemsSource="{Binding Timers}" ItemTemplate="{StaticResource TimerTemplate}" Focusable="False" />
                            <Button HorizontalAlignment="Left" Margin="0,0,0,4" Command="{Binding AddTimerCommand}" ToolTip="Add another timer (Ctrl+N)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE710;" />
                                    <TextBlock Text="Add timer" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,10,0,4" Padding="16,10,12,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Caption}" Text="TOTAL" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TotalText}" FontSize="36" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding RunningText}" TextTrimming="CharacterEllipsis"
                                           ToolTip="“Measuring since” is when the first timer was started. It starts over after Clear all." />
                            </StackPanel>
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button Grid.ColumnSpan="2" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                        Style="{DynamicResource AccentButtonStyle}"
                                        Command="{Binding SaveSnapshotCommand}"
                                        ToolTip="Add the current time of every timer (and the total) to the saved table (Ctrl+S)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE74E;" />
                                        <TextBlock Text="Save to table" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Row="1" HorizontalAlignment="Stretch" Margin="0,0,6,0"
                                        Command="{Binding StopAllCommand}" ToolTip="Pause whichever timer is running (Ctrl+0)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE71A;" />
                                        <TextBlock Text="Stop all" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                                        Command="{Binding ClearAllCommand}" ToolTip="Stop all timers and reset them to 00:00:00">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE72C;" />
                                        <TextBlock Text="Clear all" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================== Saved table ============================== -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock>
                        <Run Text="Saved table" />
                        <Run Text="{Binding Records.Count, Mode=OneWay, StringFormat=({0})}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </TextBlock>
                </TabItem.Header>
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <WrapPanel Margin="0,0,0,8">
                        <Button Margin="0,0,6,4" Command="{Binding CopyAllCommand}" ToolTip="Copy the whole table — paste straight into Excel">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE8C8;" />
                                <TextBlock Text="Copy all" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,18,4" Command="{Binding ExportCommand}" ToolTip="Save the table as a CSV file for Excel">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xEDE1;" />
                                <TextBlock Text="Export CSV…" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,6,4" Command="{Binding DeleteRowsCommand}" CommandParameter="{Binding SelectedItems, ElementName=RecordsGrid}"
                                ToolTip="Delete the selected rows (Delete key)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE74D;" />
                                <TextBlock Text="Delete selected" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,0,4" Command="{Binding ClearTableCommand}" ToolTip="Delete every row">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE894;" />
                                <TextBlock Text="Clear table" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <DataGrid x:Name="RecordsGrid" Grid.Row="1"
                              ItemsSource="{Binding Records}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" CanUserResizeRows="False"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              ClipboardCopyMode="IncludeHeader"
                              CellEditEnding="RecordsGrid_CellEditEnding"
                              PreviewKeyDown="RecordsGrid_PreviewKeyDown"
                              Loaded="RecordsGrid_Loaded">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateText, Mode=OneWay}" SortMemberPath="Date"
                                                IsReadOnly="True" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" MinWidth="80"
                                                ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Timer" Binding="{Binding TimerName, Mode=OneWay}" Width="*" MinWidth="80"
                                                IsReadOnly="True" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationText, Mode=OneWay}" SortMemberPath="Duration"
                                                IsReadOnly="True" ElementStyle="{StaticResource CellTextRight}" />
                            <DataGridTextColumn Header="Hours" Binding="{Binding HoursText, Mode=OneWay}" SortMemberPath="Duration"
                                                IsReadOnly="True" ElementStyle="{StaticResource CellTextRight}" />
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy selected rows" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C" />
                                <MenuItem Header="Copy all rows" Command="{Binding CopyAllCommand}" />
                                <Separator />
                                <MenuItem Header="Delete selected rows" InputGestureText="Del"
                                          Command="{Binding DeleteRowsCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>

                    <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="24"
                               Style="{StaticResource Caption}" FontSize="13" IsHitTestVisible="False"
                               Visibility="{Binding Records.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}"
                               x:Name="EmptyHint"
                               Text="Nothing saved yet.&#x0a;Use “Save to table” on the Timers tab to record the current times." />

                    <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Margin="2,8,0,4" TextWrapping="Wrap"
                               Text="Tip: double-click a Note cell to add a note. Select rows and press Ctrl+C to copy just those." />
                </Grid>
            </TabItem>
        </TabControl>

        <ToggleButton Style="{StaticResource IconToggle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,14,0"
                      Content="&#xE718;" IsChecked="{Binding AlwaysOnTop}" ToolTip="Keep the window on top of other windows" />

        <!-- ============================== Status bar ============================== -->
        <Border Grid.Row="1" Margin="0,8,0,0" Padding="16,0,12,0" MinHeight="42"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,4,0,4"
                        Command="{Binding UndoCommand}"
                        Visibility="{Binding CanUndo, Converter={StaticResource VisibleWhen}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE7A7;" />
                        <TextBlock Text="Undo" />
                    </StackPanel>
                </Button>
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="{Binding Notice}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasNotice, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                               Text="Ctrl+1…9 switch  ·  Ctrl+0 stop  ·  Ctrl+N add  ·  Ctrl+S save  ·  click a paused time to edit it">
                        <TextBlock.Visibility>
                            <Binding Path="HasNotice" Converter="{StaticResource VisibleWhen}" ConverterParameter="Invert" />
                        </TextBlock.Visibility>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
